{
  "name": "tasks-service",
  "version": "1.0.0",
  "description": "Express.js service for managing tasks and comments",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc",
    "start": "bun src/index.ts",
    "dev": "bun --watch src/index.ts",
    "type-check": "tsc --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-reporter=text",
    "coverage:html": "genhtml coverage/lcov.info -o coverage_report",
    "coverage": "bun run test:coverage && bun run coverage:html"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.207.0",
    "@opentelemetry/resources": "^2.1.0",
    "@opentelemetry/sdk-metrics": "^2.1.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "express": "^4.18.2",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/bun": "latest",
    "typescript": "^5.3.3"
  }
}

